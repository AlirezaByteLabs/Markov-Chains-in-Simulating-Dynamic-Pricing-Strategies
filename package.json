{
  "name": "markov-chains-in-simulating-dynamic-pricing-strategies",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export",
    "export_pdf": "slidev export --per-slide --format pdf  --output outputs/presentation.pdf",
    "export_pdf_dark": "slidev export --per-slide --format pdf --dark --output outputs/presentation-dark.pdf",
    "export_pptx": "slidev export --per-slide --format pptx  --output outputs/presentation-pptx.pptx",
    "export_pptx_dark": "slidev export --per-slide --format pptx --dark --output outputs/presentation-pptx-dark.pptx"
  },
  "dependencies": {
    "@iconify-json/uim": "^1.2.3",
    "@slidev/cli": "^51.4.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "slidev-addon-fancy-arrow": "^0.8.0",
    "slidev-addon-rabbit": "^0.4.0",
    "slidev-addon-stem": "^0.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "playwright-chromium": "^1.51.1"
  }
}